{
  "paymentMethod": "credit_card",
  "_links": {
    "self": {
      "href": "/api/payment"
    },
    "goOrderDetails": {
      "href": "/api/payment/order-details",
      "title": "Display Order Details"
    },
    "goToHome": {
      "href": "/api/home",
      "title": "Go to Home Screen"
    },
    "goToCart": {
      "href": "/api/shoppingcart",
      "title": "Go to Cart Screen"
    }
  },
  "_templates": {
    "doPaymentInfo": {
      "method": "POST",
      "target": "/api/payment/payment-info",
      "title": "Input Payment Information",
      "contentType": "application/json",
      "properties": [
        {
          "name": "paymentMethod",
          "value": "credit_card",
          "type": "text",
          "prompt": "Payment Method",
          "required": true
        }
      ]
    },
    "doPlaceOrder": {
      "method": "POST",
      "target": "/api/payment/place-order",
      "title": "Place Order",
      "contentType": "application/json",
      "properties": [
        {
          "name": "paymentMethod",
          "value": "credit_card",
          "type": "text",
          "prompt": "Payment Method",
          "required": true
        }
      ]
    }
  }
}
